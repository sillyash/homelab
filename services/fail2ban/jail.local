[sshd]
enabled = true
port    = ssh
backend = systemd
maxretry = 5
findtime = 10m
bantime  = 1h

[transmission-rpc]
# Disabled: these hosts are now behind Cloudflare Tunnel + Access, so traffic
# arrives from cloudflared on localhost and iptables bans can't block it.
enabled  = false
filter   = transmission-rpc
port     = http,https
logpath  = /var/log/nginx/access.log
maxretry = 8
findtime = 10m
bantime  = 2h

[arr-login]
# Disabled: these hosts are now behind Cloudflare Tunnel + Access, so traffic
# arrives from cloudflared on localhost and iptables bans can't block it.
enabled  = false
filter   = arr-login
port     = http,https
logpath  = /var/log/nginx/arr-access.log
maxretry = 8
findtime = 10m
bantime  = 2h
