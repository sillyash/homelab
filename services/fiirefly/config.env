# Non-secret settings for the FiiReFLY Django API (installed to /etc/fiirefly/config.env).
# Secrets (FIIREFLY_SECRET_KEY, Arise Connect client) live in /etc/fiirefly/secret.env.
# No values with spaces: manage.sh passes these through `env $(grep ...)`.
FIIREFLY_DEBUG=false
FIIREFLY_ALLOWED_HOSTS=fiirefly-api.sillyash.com
FIIREFLY_DB_PATH=/var/lib/fiirefly/db.sqlite3
FIIREFLY_STATIC_ROOT=/var/lib/fiirefly/staticfiles
FIIREFLY_FRONTEND_URL=https://sillyash.com/Krokodiile/
FIIREFLY_CORS_ALLOWED_ORIGINS=https://sillyash.com
FIIREFLY_CSRF_TRUSTED_ORIGINS=https://sillyash.com,https://fiirefly-api.sillyash.com
FIIREFLY_ARISE_REDIRECT_URI=https://fiirefly-api.sillyash.com/auth/callback/
