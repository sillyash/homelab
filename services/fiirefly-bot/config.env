# Non-secret settings for the FiiReFLY Discord bot (installed to /etc/fiirefly-bot/config.env).
# The Discord token lives in /etc/fiirefly-bot/secret.env.
# Origin allowed to read the leaderboard API (CORS): the FiiReFLY frontend.
SITE_ORIGIN=https://fiirefly.iiens.net
# Leaderboard API port: 8080 (the bot's default) is taken by dropservice, 5000/5001 by examiga/fiirefly-api.
API_PORT=5002
